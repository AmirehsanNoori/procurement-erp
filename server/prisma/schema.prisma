// Procurement ERP — Production schema
// Multi-tenant. Every operational table carries tenantId + created/updated audit columns.
// Money is stored as Decimal(18,2). Dates are stored as DateTime (ISO/UTC); the UI renders Jalali.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────
// Identity, tenancy, RBAC
// ────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)

  // Subscription / plan
  plan           String   @default("free")       // free | pro | enterprise
  planExpiresAt  DateTime?
  trialEndsAt    DateTime?
  maxUsers       Int      @default(5)
  contactEmail   String?
  billingName    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantUsers TenantUser[]
  overrides   UserPermissionOverride[]

  requests      Request[]
  quotations    Quotation[]
  budgets       Budget[]
  invoices      Invoice[]
  installments  Installment[]
  payments      Payment[]
  suppliers     Supplier[]
  documents     Document[]
  tasks         Task[]
  timeline      TimelineEvent[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  approvalWorkflows ApprovalWorkflow[]
  approvalInstances ApprovalInstance[]
  approvalVotes     ApprovalVote[]
  correspondences       Correspondence[]
  supplierContacts      SupplierContact[]
  supplierInteractions  SupplierInteraction[]
  blanketOrders         BlanketOrder[]
  expenseReports        ExpenseReport[]
  billingInvoices       BillingInvoice[]
  tenantModules         TenantModule[]
  products              Product[]
  warehouses            Warehouse[]
  stockMovements        StockMovement[]
  stockLevels           StockLevel[]
  goodsReceipts         GoodsReceipt[]
  finAccounts           FinAccount[]
  finFiscalYears        FinFiscalYear[]
  finJournals           FinJournal[]
  finJournalLines       FinJournalLine[]
  finBudgets            FinBudget[]
  finCostCenters        FinCostCenter[]
  stocktakes            Stocktake[]
  stocktakeItems        StocktakeItem[]
  purchaseOrders        PurchaseOrder[]
  supplierEvaluations   SupplierEvaluation[]
  contracts             Contract[]
  contractAmendments    ContractAmendment[]
  contractGuarantees    ContractGuarantee[]

  @@map("tenants")
}

// ── Inventory / Warehouse module ─────────────────────────────────────────────

/// Product / item master.
model Product {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  category    String?
  unit        String? // unit of measure
  barcode     String?
  minStock    Decimal? @db.Decimal(18, 3)
  isActive    Boolean  @default(true)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  levels       StockLevel[]
  receiptItems GoodsReceiptItem[]
  stocktakeItems StocktakeItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("products")
}

/// Physical/logical warehouse or store location.
model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  levels    StockLevel[]
  receipts  GoodsReceipt[]
  stocktakes Stocktake[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

/// A goods receipt document: what the warehouse received against a procurement
/// invoice (soft cross-module reference to procurement).
model GoodsReceipt {
  id            String   @id @default(cuid())
  tenantId      String
  warehouseId   String
  refModule     String? // 'procurement'
  refType       String? // 'invoice'
  refId         String? // invoice id
  requestRefId  String? // originating request id (soft)
  note          String?
  receivedById  String?
  receivedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     GoodsReceiptItem[]

  @@index([tenantId])
  @@index([refId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id          String  @id @default(cuid())
  tenantId    String
  receiptId   String
  productId   String
  quantity    Decimal @db.Decimal(18, 3)
  unitCost    Decimal? @db.Decimal(18, 2) // purchase unit cost (inventory valuation)
  note        String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("goods_receipt_items")
}

/// Physical inventory count (انبارگردانی): snapshot system qty, enter counted
/// qty, then reconcile variances via adjustment movements on completion.
model Stocktake {
  id          String    @id @default(cuid())
  tenantId    String
  warehouseId String
  number      Int
  status      String    @default("draft") // draft | completed
  date        DateTime  @default(now())
  note        String?
  createdById String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items     StocktakeItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("stocktakes")
}

model StocktakeItem {
  id          String   @id @default(cuid())
  tenantId    String
  stocktakeId String
  productId   String
  systemQty   Decimal  @db.Decimal(18, 3) // on-hand snapshot at creation
  countedQty  Decimal? @db.Decimal(18, 3) // physical count
  unitCost    Decimal  @default(0) @db.Decimal(18, 2) // avg cost snapshot for variance value
  note        String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([stocktakeId])
  @@map("stocktake_items")
}

/// Source of truth for stock: every receipt/issue/transfer/adjustment.
model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  type        String // receipt | issue | transfer_in | transfer_out | adjustment
  quantity    Decimal  @db.Decimal(18, 3) // always positive; sign implied by type
  unitCost    Decimal? @db.Decimal(18, 2) // valuation: inflow cost, or moving-avg COGS on outflow
  value       Decimal? @db.Decimal(18, 2) // quantity × unitCost
  date        DateTime @default(now())
  refModule   String? // soft cross-module reference (ADR-0009)
  refType     String?
  refId       String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_movements")
}

/// Cached on-hand quantity per product+warehouse (derived from movements).
model StockLevel {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(18, 3)
  avgCost     Decimal  @default(0) @db.Decimal(18, 2) // moving-average unit cost
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([tenantId])
  @@map("stock_levels")
}

/// Which platform modules a tenant may use (Core entitlement, ADR-0004).
/// Default-allow: absence of a row means the module is available; an explicit
/// row with enabled=false hides it for that tenant.
model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  moduleKey String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("tenant_modules")
}

// ── Finance module (General Ledger) ──────────────────────────────────────────
// Double-entry accounting. Chart of accounts is a tree; only postable (leaf)
// accounts accept journal lines. Journals must balance (Σdebit = Σcredit).
// Cross-module links to procurement (invoice/payment) use soft references.

/// A node in the chart of accounts (کدینگ حساب‌ها). Tree via parentId.
model FinAccount {
  id         String   @id @default(cuid())
  tenantId   String
  code       String // account code, unique per tenant
  name       String
  type       String // asset | liability | equity | income | expense
  parentId   String?
  level      Int      @default(1)
  isPostable Boolean  @default(true) // only leaf/معین accounts accept journal lines
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   FinAccount?      @relation("FinAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children FinAccount[]     @relation("FinAccountTree")
  lines    FinJournalLine[]
  budgets  FinBudget[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("fin_accounts")
}

/// Per-account budget for a fiscal year (بودجه). Compared against posted actuals.
model FinBudget {
  id           String   @id @default(cuid())
  tenantId     String
  accountId    String
  fiscalYearId String
  amount       Decimal  @db.Decimal(18, 2)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account    FinAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fiscalYear FinFiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountId, fiscalYearId])
  @@index([tenantId])
  @@index([fiscalYearId])
  @@map("fin_budgets")
}

/// Fiscal year (سال مالی). Journals are dated inside an open year.
model FinFiscalYear {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  startDate DateTime
  endDate   DateTime
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journals FinJournal[]
  budgets  FinBudget[]

  @@index([tenantId])
  @@map("fin_fiscal_years")
}

/// Accounting document header (سند حسابداری). Posted docs are immutable —
/// corrections are made by voiding or a reversing entry.
model FinJournal {
  id           String    @id @default(cuid())
  tenantId     String
  number       Int // sequential per tenant
  date         DateTime
  description  String?
  status       String    @default("draft") // draft | posted | void
  fiscalYearId String?
  refModule    String? // soft cross-module reference (ADR-0009), e.g. 'procurement'
  refType      String? // 'invoice' | 'payment'
  refId        String?
  reversalOfId String? // if this doc reverses another
  postedAt     DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear FinFiscalYear?   @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  lines      FinJournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([refId])
  @@map("fin_journals")
}

/// A single line of a journal (آرتیکل). Exactly one of debit/credit is > 0.
model FinJournalLine {
  id          String  @id @default(cuid())
  tenantId    String
  journalId   String
  accountId   String
  debit        Decimal @default(0) @db.Decimal(18, 2)
  credit       Decimal @default(0) @db.Decimal(18, 2)
  description  String?
  costCenterId String? // optional analytical dimension (مرکز هزینه)
  sortOrder    Int     @default(0)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journal    FinJournal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account    FinAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter FinCostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([journalId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("fin_journal_lines")
}

/// Analytical dimension for reporting (مرکز هزینه). Optional on journal lines,
/// so a single document can split cost across centres (department, project, ...).
model FinCostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  FinJournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("fin_cost_centers")
}

model BillingInvoice {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceNo   String?
  plan        String
  amount      Decimal  @default(0) @db.Decimal(18,2)
  currency    String   @default("ریال")
  status      String   @default("پرداخت شده")  // پرداخت شده | در انتظار | لغو شده
  periodStart DateTime?
  periodEnd   DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("billing_invoices")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantUsers   TenantUser[]
  overrides     UserPermissionOverride[]
  refreshTokens RefreshToken[]
  approvalVotes ApprovalVote[]
  assignedRequests Request[] @relation("RequestAssignee")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantUsers     TenantUser[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// A user's membership in a tenant, with a role. Permissions = role defaults + per-user overrides.
model TenantUser {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  roleId   String
  isActive Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_users")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "requests.create"
  module      String   // e.g. "requests"
  action      String   // e.g. "create"
  description String?

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Per-user, per-tenant explicit allow/deny that overrides the role default.
model UserPermissionOverride {
  id           String  @id @default(cuid())
  tenantId     String
  userId       String
  permissionId String
  allowed      Boolean

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, permissionId])
  @@map("user_permission_overrides")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ────────────────────────────────────────────────
// Core business tables
// ────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  bankAccount   String?
  notes         String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests   Request[]
  quotations Quotation[]
  invoices   Invoice[]
  contacts      SupplierContact[]
  interactions  SupplierInteraction[]
  blanketOrders BlanketOrder[]
  purchaseOrders PurchaseOrder[]
  evaluations   SupplierEvaluation[]
  contracts     Contract[]

  @@index([tenantId])
  @@map("suppliers")
}

/// Formal purchase order (سفارش خرید) — the P2P commitment between quotation
/// selection and supplier invoicing. Enables three-way match (PO/GRN/invoice).
model PurchaseOrder {
  id           String    @id @default(cuid())
  tenantId     String
  poNumber     String
  supplierId   String?
  requestId    String? // soft origin (procurement request)
  quotationId  String? // soft origin (winning quotation)
  status       String    @default("draft") // draft | approved | sent | received | closed | cancelled
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  currency     String    @default("ریال")
  netAmount    Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount    Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount  Decimal   @default(0) @db.Decimal(18, 2)
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(cuid())
  tenantId    String
  poId        String
  productId   String? // optional catalog link
  description String
  quantity    Decimal  @db.Decimal(18, 3)
  unit        String?
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(18, 2)
  sortOrder   Int      @default(0)

  order PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@map("purchase_order_items")
}

/// Periodic supplier scorecard (ارزیابی تأمین‌کننده) — quality/delivery/price.
model SupplierEvaluation {
  id            String   @id @default(cuid())
  tenantId      String
  supplierId    String
  period        String? // e.g. "۱۴۰۵-بهار" or free text
  qualityScore  Int // 1..5
  deliveryScore Int // 1..5
  priceScore    Int // 1..5
  overallScore  Decimal @db.Decimal(4, 2) // average of the three
  note          String?
  evaluatedById String?
  createdAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplierId])
  @@map("supplier_evaluations")
}

// ── Contracts module (مدیریت قراردادها) ──────────────────────────────────────

/// A contract with a counterparty (usually a supplier). Tracks value, term,
/// renewal, plus linked amendments and guarantees.
model Contract {
  id               String    @id @default(cuid())
  tenantId         String
  contractNumber   String
  title            String
  type             String    @default("purchase") // purchase | service | lease | framework | other
  partyName        String? // free-text counterparty when not a system supplier
  supplierId       String? // optional link to a supplier
  status           String    @default("draft") // draft | active | suspended | expired | terminated | renewed | closed
  value            Decimal   @default(0) @db.Decimal(18, 2)
  currency         String    @default("ریال")
  startDate        DateTime?
  endDate          DateTime?
  autoRenew        Boolean   @default(false)
  renewalNoticeDays Int? // notice window before endDate
  description      String?
  notes            String?
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier?           @relation(fields: [supplierId], references: [id])
  amendments ContractAmendment[]
  guarantees ContractGuarantee[]

  @@unique([tenantId, contractNumber])
  @@index([tenantId])
  @@map("contracts")
}

/// A contract amendment (متمم) — a change to value and/or term.
model ContractAmendment {
  id              String    @id @default(cuid())
  tenantId        String
  contractId      String
  amendmentNumber String
  date            DateTime  @default(now())
  description     String?
  valueChange     Decimal?  @db.Decimal(18, 2) // signed delta to contract value
  newEndDate      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_amendments")
}

/// A guarantee / bond attached to a contract (ضمانت‌نامه).
model ContractGuarantee {
  id              String    @id @default(cuid())
  tenantId        String
  contractId      String
  type            String    @default("performance") // performance | advance | bid | warranty | retention
  guaranteeNumber String?
  amount          Decimal   @default(0) @db.Decimal(18, 2)
  currency        String    @default("ریال")
  bankName        String?
  issueDate       DateTime?
  expiryDate      DateTime?
  status          String    @default("active") // active | released | expired | claimed
  notes           String?
  createdAt       DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_guarantees")
}

model SupplierContact {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  fullName   String
  role       String?
  phone      String?
  email      String?
  notes      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplierId])
  @@map("supplier_contacts")
}

model SupplierInteraction {
  id           String   @id @default(cuid())
  tenantId     String
  supplierId   String
  type         String   @default("یادداشت") // 'یادداشت' | 'تماس تلفنی' | 'جلسه' | 'ایمیل' | 'بازدید'
  subject      String?
  body         String?
  interactionDate DateTime?
  followUpDate DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplierId])
  @@map("supplier_interactions")
}

model BlanketOrder {
  id            String    @id @default(cuid())
  tenantId      String
  supplierId    String
  orderNumber   String?
  description   String
  totalValue    Decimal   @default(0) @db.Decimal(18, 2)
  usedValue     Decimal   @default(0) @db.Decimal(18, 2)
  currency      String    @default("ریال")
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("فعال") // 'فعال' | 'تکمیل شده' | 'لغو شده' | 'منقضی'
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@map("blanket_orders")
}

model Request {
  id                 String    @id @default(cuid())
  tenantId           String
  requestNumber      String // QUOTE NO / PQ
  orderNo            String?
  title              String?
  description        String?
  category           String?
  requestDate        DateTime?
  documentDate       DateTime?
  receivedDate       DateTime?
  weeklySegmentation String?
  receivedPercentage Decimal?  @db.Decimal(5, 2)
  estimatedAmount    Decimal?  @db.Decimal(18, 2)
  supplierId         String?
  status             String    @default("جدید")
  followUpDate       DateTime?
  deliveryDate       DateTime?
  serviceDate        DateTime?
  driver             String?
  serviceProvider    String?
  notes              String?
  ioidRow            Int?
  ioidRemark         String?
  cost               Decimal?  @db.Decimal(18, 2)
  archived           Boolean   @default(false)
  assigneeId         String?
  requestingUnit     String? // unit/department that raised the request (warehouse intake)
  source             String? // who registered it: 'warehouse' (intake) | 'procurement'
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  assignee   User?       @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  quotations Quotation[]
  invoices         Invoice[]
  correspondences  Correspondence[]
  items            RequestItem[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([assigneeId])
  @@map("requests")
}

/// Line items on a procurement request (warehouse intake detail): category,
/// description, quantity, unit of measure, optional pricing + tax.
model RequestItem {
  id          String   @id @default(cuid())
  tenantId    String
  requestId   String
  productId   String? // optional link to the product catalog (enterprise item master)
  category    String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(18, 3)
  unit        String? // unit of measure (عدد، کیلوگرم، ...)
  unitPrice   Decimal? @db.Decimal(18, 2)
  lineTotal   Decimal? @db.Decimal(18, 2)
  taxAmount   Decimal? @db.Decimal(18, 2)
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requestId])
  @@map("request_items")
}

model Quotation {
  id                  String    @id @default(cuid())
  tenantId            String
  requestId           String?
  quotationNumber     String?
  supplierId          String?
  date                DateTime?
  amount              Decimal?  @db.Decimal(18, 2)
  currency            String    @default("ریال")
  status              String    @default("در انتظار سفارش")
  budgetId            String?
  followUpDate        DateTime?
  deliveryDate        DateTime?
  serviceDate         DateTime?
  driver              String?
  serviceProvider     String?
  deliveryNotes       String?
  advancePaymentAmount Decimal? @db.Decimal(18, 2)
  advancePaymentDate  DateTime?
  paymentBatchNumber  String?
  accountingReference String?
  notes               String?
  archived            Boolean   @default(false)
  createdById         String?
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request  Request?  @relation(fields: [requestId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  budget   Budget?   @relation(fields: [budgetId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("quotations")
}

model Budget {
  id                String   @id @default(cuid())
  tenantId          String
  name              String?
  yearJalali        Int
  monthJalali       Int
  estimatedCost     Decimal  @default(0) @db.Decimal(18, 2)
  contingencyPercent Decimal @default(0) @db.Decimal(6, 2)
  requiredBudget    Decimal  @default(0) @db.Decimal(18, 2)
  approvedBudget    Decimal  @default(0) @db.Decimal(18, 2)
  manualActual      Decimal? @db.Decimal(18, 2)
  varianceReason    String?
  notes             String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations BudgetAllocation[]
  quotations  Quotation[]
  invoices    Invoice[]

  @@index([tenantId])
  @@index([tenantId, yearJalali, monthJalali])
  @@map("budgets")
}

model BudgetAllocation {
  id          String  @id @default(cuid())
  tenantId    String
  budgetId    String
  yearJalali  Int
  monthJalali Int
  percentage  Decimal @default(0) @db.Decimal(6, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("budget_allocations")
}

model Invoice {
  id                      String    @id @default(cuid())
  tenantId                String
  invoiceNumber           String
  requestId               String?
  quotationId             String?
  poId                    String? // soft link to purchase order (three-way match)
  supplierId              String?
  invoiceDate             DateTime?
  dueDate                 DateTime?
  netAmount               Decimal?  @db.Decimal(18, 2)
  vatAmount               Decimal?  @db.Decimal(18, 2)
  totalAmount             Decimal   @default(0) @db.Decimal(18, 2)
  status                  String    @default("در انتظار بودجه")
  budgetId                String?
  batch                   String?
  accountingReference     String?
  accountingNotes         String?
  sentToAccounting        Boolean   @default(false)
  accountingSubmissionDate DateTime?
  followUpDate            DateTime?
  notes                   String?
  archived                Boolean   @default(false)
  // Procure-to-receive-to-pay handoff (Phase C):
  sentToWarehouseAt       DateTime? // procurement handed the invoice to the warehouse for receipt
  receivedAt              DateTime? // warehouse registered the goods receipt (stock in)
  sentToFinanceAt         DateTime? // procurement forwarded the received invoice to finance
  createdById             String?
  updatedById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request      Request?      @relation(fields: [requestId], references: [id])
  quotation    Quotation?    @relation(fields: [quotationId], references: [id])
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  budget       Budget?       @relation(fields: [budgetId], references: [id])
  installments Installment[]
  payments         Payment[]
  correspondences  Correspondence[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

model Installment {
  id        String    @id @default(cuid())
  tenantId  String
  invoiceId String
  amount    Decimal   @default(0) @db.Decimal(18, 2)
  percent   Decimal?  @db.Decimal(6, 2)
  monthKey  String? // "1403-09"
  dueDate   DateTime?
  status    String    @default("در انتظار")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("installments")
}

model Payment {
  id                String    @id @default(cuid())
  tenantId          String
  invoiceId         String
  paymentDate       DateTime?
  amount            Decimal   @default(0) @db.Decimal(18, 2)
  paymentListNumber String?
  reference         String?
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model Document {
  id               String   @id @default(cuid())
  tenantId         String
  entityType       String // request | quotation | invoice | budget | supplier | payment
  entityId         String
  category         String?
  filename         String
  originalFilename String?
  mimeType         String?
  size             Int?
  storagePath      String
  uploadedById     String?
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

model Task {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  description     String?
  priority        Int       @default(2) // 1 low, 2 medium, 3 high
  dueDate         DateTime?
  followUpDate    DateTime?
  status          String    @default("در انتظار")
  relatedRequestId String?
  relatedInvoiceId String?
  assignedToId    String?
  archived        Boolean   @default(false)
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tasks")
}

model TimelineEvent {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  eventType  String
  eventDate  DateTime?
  userId     String?
  userName   String?
  supplier   String?
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("timeline_events")
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  level       String // critical | important | info
  title       String
  description String?
  entityType  String?
  entityId    String?
  reference   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notifications")
}

// Audit log for sensitive actions (security section 28).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// Approval Workflow
// ─────────────────────────────────────────

model ApprovalWorkflow {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  entityType String   // 'invoice' | 'quotation' | 'request'
  steps      Json     // [{label, requiredRole, order}]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instances ApprovalInstance[]

  @@index([tenantId])
  @@map("approval_workflows")
}

model ApprovalInstance {
  id            String   @id @default(cuid())
  tenantId      String
  workflowId    String
  entityType    String
  entityId      String
  currentStep   Int      @default(0)
  status        String   @default("در انتظار")
  requestedById String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  votes    ApprovalVote[]

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("approval_instances")
}

model ApprovalVote {
  id         String   @id @default(cuid())
  tenantId   String
  instanceId String
  step       Int
  userId     String
  decision   String   // 'تأیید شده' | 'رد شده'
  notes      String?
  createdAt  DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id])

  @@map("approval_votes")
}

model Correspondence {
  id             String    @id @default(cuid())
  tenantId       String
  letterNumber   String?
  direction      String    // 'صادره' | 'وارده'
  subject        String
  body           String?
  senderName     String?
  recipientName  String?
  letterDate     DateTime?
  receivedDate   DateTime?
  priority       String    @default("عادی") // 'عادی' | 'فوری' | 'خیلی‌فوری'
  status         String    @default("ثبت شده") // 'ثبت شده' | 'در جریان' | 'بایگانی' | 'پاسخ داده شده'
  relatedRequestId String?
  relatedInvoiceId String?
  attachmentPath String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request Request? @relation(fields: [relatedRequestId], references: [id])
  invoice Invoice? @relation(fields: [relatedInvoiceId], references: [id])

  @@index([tenantId])
  @@map("correspondences")
}

model ExpenseReport {
  id           String    @id @default(cuid())
  tenantId     String
  reportNumber String?
  title        String
  submittedBy  String?
  department   String?
  periodStart  DateTime?
  periodEnd    DateTime?
  totalAmount  Decimal   @default(0) @db.Decimal(18, 2)
  currency     String    @default("ریال")
  status       String    @default("پیش‌نویس") // 'پیش‌نویس' | 'ارسال شده' | 'تأیید شده' | 'رد شده' | 'پرداخت شده'
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ExpenseItem[]

  @@index([tenantId])
  @@map("expense_reports")
}

model ExpenseItem {
  id          String   @id @default(cuid())
  reportId    String
  category    String   // 'حمل‌ونقل' | 'پذیرایی' | 'اقامت' | 'ارتباطات' | 'اداری' | 'سایر'
  description String
  amount      Decimal  @db.Decimal(18, 2)
  expenseDate DateTime?
  receiptRef  String?
  createdAt   DateTime @default(now())

  report ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("expense_items")
}
