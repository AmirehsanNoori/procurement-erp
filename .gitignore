# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo
# ...except the compiled Core runtime, which is shipped so Node/Vercel can load
# @lumentra/core-runtime at runtime without a build step (it's a TS-source pkg).
!core/runtime/dist/
!core/runtime/dist/**

# Env
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# Uploads (local file storage)
uploads/

# Prisma
server/prisma/*.db

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Coverage
coverage/

# Vercel
.vercel/

# Service Worker cache
web/public/sw-*.js

.vercel
.env*
# ...except the production web API base (no secrets): Vercel builds have no
# web/.env, so this pins VITE_API_URL to the same-origin /api for every deploy.
!web/.env.production
.github/workflows/

# Local-only project guide (not committed, per request)
/CLAUDE.md
